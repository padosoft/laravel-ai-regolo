parameters:
    level: 5
    paths:
        - src
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # The capability interfaces (TextProvider, EmbeddingProvider,
        # RerankingProvider, ImageProvider, AudioProvider,
        # TranscriptionProvider) are guaranteed to be implemented by a
        # class extending the abstract Provider — that is the SDK's
        # contract. PHPStan cannot follow the registry-binding flow that
        # hands the interface-typed argument to a Provider-typed concern.
        - identifier: argument.type
          message: '#expects Laravel\\Ai\\Providers\\Provider, Laravel\\Ai\\Contracts\\Providers\\(Text|Embedding|Reranking|Image|Audio|Transcription)Provider given#'
          path: src/Gateway/Regolo/*

        # (An ignore for undefined name() / driver() /
        # additionalConfiguration() on the capability interfaces sat here.
        # laravel/ai 0.11 no longer reports it, and PHPStan flags an ignore
        # that matches nothing -- correctly, since a suppression outliving
        # its cause silently hides whatever error later fits its shape.)

        # Upstream Mistral concern keeps a `!== null` guard on a typed
        # property the SDK widens to `mixed` in PHPDoc only — the runtime
        # value is unambiguous, the static check is the false positive.
        - identifier: notIdentical.alwaysTrue
          message: '#Strict comparison using !== between mixed and null will always evaluate to true#'
          path: src/Gateway/Regolo/Concerns/HandlesTextStreaming.php
